unt":0,"wasTbbBuddyRead":false,"review":null},{"book":{"id":"goodreads-242986390","title":"The Harbinger: Spectral Hunter Series","authors":["Morgan  Kessler"],"pageCount":276,"publicationDate":"2025","publisher":"A Little Vast Studios, LLC","status":"read","genreIds":[],"tropeIds":[],"tagIds":[],"shelfIds":[],"formats":["ebook"],"ownership":[],"primaryFormat":"ebook","personalRating":3,"certifiedSlay":false,"brainChemistry":false,"favorite":false,"goodreadsBookId":"242986390","dateAdded":"2026-01-02","source":"goodreads","createdAt":"2026-10-06T16:56:09.942Z","updatedAt":"2026-10-06T16:56:09.942Z"},"readingRecord":{"id":"goodreads-242986390-read-1","bookId":"goodreads-242986390","status":"completed","readingMethod":"ebook","finishedAt":"2026-01-04","rating":3,"certifiedSlay":false,"readingNumber":1,"isReread":false,"progressEntries":[],"createdAt":"2026-10-06T16:56:09.942Z","updatedAt":"2026-10-06T16:56:09.942Z"},"rawShelves":[],"readCount":1,"wasTbbBuddyRead":false,"review":{"id":"goodreads-review-242986390","bookId":"goodreads-242986390","readingRecordId":"goodreads-242986390-read-1","rating":3,"body":"The Harbinger is a solid supernatural thriller that I’m convinced would make an incredible TV show. The atmosphere is moody and the \"FBI agent meets occult ritual\" hook is perfect for a weekend binge-watch. I can easily see this being a hit on screen because the core concept is so visually striking and high-stakes.<br/><br/>However, the reading experience was a bit of a struggle due to the overly detailed descriptions. While the world-building is thorough, the constant, dense prose often slowed the plot down right when things were getting good. It’s a great story, but I found myself wishing the pacing was as fast as the action it was describing.<br/><br/>I received an advance review copy for free, and I am leaving this review voluntarily.","containsSpoilers":false,"createdAt":"2026-01-04T00:00:00.000Z","updatedAt":"2026-01-04T00:00:00.000Z"}},{"book":{"id":"goodr