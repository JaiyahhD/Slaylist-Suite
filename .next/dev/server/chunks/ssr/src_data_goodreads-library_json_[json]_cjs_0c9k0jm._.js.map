"isbn10":"1335081151","isbn13":"9781335081155","pageCount":272,"publicationDate":"2024","publisher":"Hanover Square Press","status":"read","genreIds":[],"tropeIds":[],"tagIds":[],"shelfIds":[],"formats":["physical"],"ownership":[],"primaryFormat":"physical","personalRating":3,"certifiedSlay":false,"brainChemistry":false,"favorite":false,"goodreadsBookId":"207590216","dateAdded":"2025-02-04","source":"goodreads","createdAt":"2026-10-06T16:56:09.942Z","updatedAt":"2026-10-06T16:56:09.942Z"},"readingRecord":{"id":"goodreads-207590216-read-1","bookId":"goodreads-207590216","status":"completed","readingMethod":"physical","finishedAt":"2026-01-24","rating":3,"certifiedSlay":false,"readingNumber":1,"isReread":false,"progressEntries":[],"createdAt":"2026-10-06T16:56:09.942Z","updatedAt":"2026-10-06T16:56:09.942Z"},"rawShelves":[],"readCount":1,"wasTbbBuddyRead":false,"review":null},{"book":{"id":"goodreads-63891858","title":"Kiss of the Night (Dark-Hunter, #5)","authors":["Sherrilyn Kenyon"],"pageCount":368,"publicationDate":"2004","publisher":"St. Martin's Press","status":"tbr","genreIds":[],"tropeIds":[],"tagIds":[],"shelfIds":[],"formats":["ebook"],"ownership":[],"primaryFormat":"ebook","certifiedSlay":false,"brainChemistry":false,"favorite":false,"goodreadsBookId":"63891858","dateAdded":"2025-10-24","source":"goodreads","createdAt":"2026-10-06T16:56:09.942Z","updatedAt":"2026-10-06T16:56:09.942Z"},"readingRecord":null,"rawShelves":["to-read"],"readCount":2,"wasTbbBuddyRead":false,"review":null},{"book":{"id":"goodreads-198701013","title":"Blood at the Root","authors":["LaDarrion Williams"],"isbn10":"0593711955","isbn13":"9780593711958","pageCount":421,"publicationDate":"2024","publisher":"Labyrinth Road","status":"read","genreIds":[],"tropeIds":[],"tagIds":[],"shelfIds":[],"formats":["ebook"],"ownership":[],"primaryFormat":"ebook","personalRating":5,"certifiedSlay":true,"brainChemistry":false,"favorite":false,"goodreadsBookId":"198701013","dateAdded":"2025-11-29","source":"goodreads","createdAt":"2026-10-06T16:56:09.942Z","updatedAt":"2026-10-06T16:56:09.942Z","coverUrl":"https://covers.openlibrary.org/b/id/14627213-L.jpg"},"readingRecord":{"id":"goodreads-198701013-read-1","bookId":"goodreads-198701013","status":"completed","readingMethod":"ebook","finishedAt":"2026-01-16","rating":5,"certifiedSlay":true,"readingNumber":1,"isReread":false,"progressEntries":[],"createdAt":"2026-10-06T16:56:09.942Z","updatedAt":"2026-10-06T16:56:09.942Z"},"rawShelves":["5-star-reads"],"readCount":1,"wasTbbBuddyRead":false,"review":{"id":"goodreads-review-198701013","bookId":"goodreads-198701013","readingRecordId":"goodreads-198701013-read-1","rating":5,"body":"Review: Blood at the Root – A Masterclass in Magic and Authenticity<br/>Rating: ⭐⭐⭐⭐⭐️ (5/5)<br/><br/>If you are looking for a story that feels as real as your own backyard while simultaneously blowing your mind with supernatural stakes, this is it.<br/><br/>The Vibes: Unapologetically Us<br/>The first thing that hits you is the authenticity. This isn't a story trying to fit Black characters into a \"traditional\" mold; it’s a story where the personality, the dialogue, and the rhythm of life match our actual reality. The characters felt like people I know—their humor, their protective nature, and that specific \"way we move.\" It was refreshing to see an African American experience centered so naturally in a world of magic.<br/><br/>The Plot: Expect the Unexpected<br/>I’m usually pretty good at sniffing out a plot twist a mile away, but LaDarrion Williams played me! The twists and turns in this book are top-tier. Just when I thought I had the mystery of Malik’s past and the secrets of the hidden HBCU (Caster) figured out, the rug was pulled out from under me.<br/><br/>The Drama: High Stakes and Heart<br/>The drama is dialed up to 100, but it never feels forced. Whether it’s the internal friction within the magic school or the larger-than-life external threats, I was hooked from page one. It’s got:<br/><br/>Deep-rooted secrets that keep you turning pages.<br/><br/>Complex relationships that feel earned and messy.<br/><br/>A unique magic system that feels grounded in history. My first 5-star of the year!","containsSpoilers":false,"createdAt":"2026-01-16T00:00:00.000Z","updatedAt":"2026-01-16T00:00:00.000Z"}},{"book":{"id":"goodreads-228747180","title":"Bullet: A Forbidden Romance (BLP Motorcycle Clubs Book 1)","authors":["Wynta Tyme"],"pageCount":112,"publicationDate":"2025","publisher":"B. Love Publications","status":"read","genreIds":[],"tropeIds":[],"tagIds":[],"shelfIds":[],"formats":["ebook"],"ownership":[],"primaryFormat":"ebook","personalRating":4,"certifiedSlay":false,"brainChemistry":false,"favorite":false,"goodreadsBookId":"228747180","dateAdded":"2025-08-10","source":"goodreads","createdAt":"2026-10-06T16:56:09.942Z","updatedAt":"2026-10-06T16:56:09.942Z"},"readingRecord":{"id":"goodreads-228747180-read-1","bookId":"goodreads-228747180","status":"completed","readingMethod":"ebook","finishedAt":"2026-01-20","rating":4,"certifiedSlay":false,"readingNumber":1,"isReread":false,"progressEntries":[],"createdAt":"2026-10-06T16:56:09.942Z","updatedAt":"2026-10-06T16:56:09.942Z"},"rawShelves":[],"readCount":1,"wasTbbBuddyRead":false,"review":null},{"book":{"id":"goodreads-229220984","title":"Miss Mary Mack","authors":["Deandre Kralevic"],"pageCount":129,"publicationDate":"2025","status":"tbr","genreIds":[],"tropeIds":[],"tagIds":[],"shelfIds":[],"formats":["ebook"],"ownership":[],"primaryFormat":"ebook","certifiedSlay":false,"brainChemistry":false,"favorite":false,"goodreadsBookId":"229220984","dateAdded":"2026-01-20","source":"goodreads","createdAt":"2026-10-06T16:56:09.942Z","updatedAt":"2026-10-06T16:56:09.942Z"},"readingRecord":null,"rawShelves":["to-read"],"readCount":0,"wasTbbBuddyRead":false,"review":null},{"book":{"id":"goodreads-243109195","title":"Echoes of Fate (Odidere, #2)","authors":["Tobiloba Afolayan"],"isbn10":"9786986865","isbn13":"978