physical"],"ownership":[],"primaryFormat":"physical","personalRating":3,"certifiedSlay":false,"brainChemistry":false,"favorite":false,"goodreadsBookId":"42603984","dateAdded":"2025-09-28","source":"goodreads","createdAt":"2026-10-06T16:56:09.945Z","updatedAt":"2026-10-06T16:56:09.945Z","coverUrl":"https://covers.openlibrary.org/b/isbn/9781474967532-L.jpg"},"readingRecord":{"id":"goodreads-42603984-read-1","bookId":"goodreads-42603984","status":"completed","readingMethod":"physical","finishedAt":"2025-10-06","rating":3,"certifiedSlay":false,"readingNumber":1,"isReread":false,"progressEntries":[],"createdAt":"2026-10-06T16:56:09.945Z","updatedAt":"2026-10-06T16:56:09.945Z"},"rawShelves":[],"readCount":1,"wasTbbBuddyRead":false,"review":{"id":"goodreads-review-42603984","bookId":"goodreads-42603984","readingRecordId":"goodreads-42603984-read-1","rating":3,"body":"It took a little bit of time for me to truly get into Ace of Spades. The beginning felt slow, but once the ball started rolling with the anonymous \"Aces,\" I was reeled in. The story had a lot of twists and turns... they just kept coming, which made it a compelling thriller. I thought the social commentary was expertly woven into the plot. However, out of all the shocks, there was one twist that completely broke my heart. It was a truly devastating moment that hit me hard and left a lingering feeling. While I appreciate the author's ambitious plot and the powerful themes of institutionalized racism, the slow initial pace and the emotional intensity of that one particular development kept me from giving it a higher rating. Overall, I thought it was a solid, thought-provoking read!","containsSpoilers":false,"createdAt":"2025-10-06T00:00:00.000Z","updatedAt":"2025-10-06T00:00:00.000Z"}},{"book":{"id":"goodreads-216288560","title":"The Chaos Weaver (Threads of Chaos #1)","authors":["Aubrey Winters"],"pageCount":308,"publicationDate":"2025","status":"tbr","genreIds":[],"tropeIds":[],"tagIds":[],"shelfIds":[],"form