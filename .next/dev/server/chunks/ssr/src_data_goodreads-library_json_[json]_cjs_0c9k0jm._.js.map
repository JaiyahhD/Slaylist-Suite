inChemistry":false,"favorite":false,"goodreadsBookId":"228143091","dateAdded":"2025-11-19","source":"goodreads","createdAt":"2026-10-06T16:56:09.944Z","updatedAt":"2026-10-06T16:56:09.944Z","coverUrl":"https://covers.openlibrary.org/b/id/15226699-L.jpg"},"readingRecord":null,"rawShelves":["to-read"],"readCount":0,"wasTbbBuddyRead":false,"review":null},{"book":{"id":"goodreads-231726923","title":"Breaking Lily: A Dark Psychological Romance","authors":["Zaira DuMal"],"pageCount":157,"publicationDate":"2025","status":"read","genreIds":[],"tropeIds":[],"tagIds":[],"shelfIds":[],"formats":["ebook"],"ownership":[],"primaryFormat":"ebook","personalRating":2,"certifiedSlay":false,"brainChemistry":false,"favorite":false,"goodreadsBookId":"231726923","dateAdded":"2025-11-15","source":"goodreads","createdAt":"2026-10-06T16:56:09.944Z","updatedAt":"2026-10-06T16:56:09.944Z"},"readingRecord":{"id":"goodreads-231726923-read-1","bookId":"goodreads-231726923","status":"completed","readingMethod":"ebook","finishedAt":"2025-11-15","rating":2,"certifiedSlay":false,"readingNumber":1,"isReread":false,"progressEntries":[],"createdAt":"2026-10-06T16:56:09.944Z","updatedAt":"2026-10-06T16:56:09.944Z"},"rawShelves":[],"readCount":1,"wasTbbBuddyRead":false,"review":{"id":"goodreads-review-231726923","bookId":"goodreads-231726923","readingRecordId":"goodreads-231726923-read-1","rating":2,"body":"Thank you to the author for the ARC in exchange for my honest review.<br/><br/>Breaking Lily is a dark and emotionally heavy story — and I mean dark. I went in expecting a painful journey, but this book delivers wave after wave of trauma with almost no space to breathe. Lily’s experiences are heartbreaking, and while her resilience is clear, the sheer amount of suffering she endures made the story feel more overwhelming than immersive at times.<br/><br/>What ultimately made this a 2-star read for me is the HEA. It doesn’t feel like true healing or safety — more like Lily ended up with the least harmful option rather than a genuinely healthy, secure love. After everything she went through, I wanted a happier ending that felt like actual peace, not just the safest corner of a traumatic world.<br/><br/>Readers who love extremely dark, psychologically intense stories may connect with this more than I did. But for me, the trauma overshadowed the character growth, and the resolution didn’t give Lily the kind of freedom or healing she deserved.","containsSpoilers":false,"createdAt":"2025-11-15T00:00:00.000Z","updatedAt":"2025-11-15T00:00:00.000Z"}},{"book":{"id":"goodreads-231819058","title":"The Intruder","authors":["Freida McFadden"],"isbn10":"1464260915","isbn13":"9781464260919","pageCount":279,"publicationDate":"2025","publisher":"Poisoned Pen Press","status":"read","genreIds":[],"tropeIds":[],"tagIds":[],"shelfIds":[],"formats":["physical"],"ownership":[],"primaryFormat":"physical","personalRating":3,"certifiedSlay":false,"brainChemistry":false,"favorite":false,"goodreadsBookId":"231819058","dateAdded":"2025-06-02","source":"goodreads","createdAt":"2026-10-06T16:56:09.944Z","updatedAt":"2026-10-06T16:56:09.944Z","coverUrl":"https://covers.openlibrary.org/b/isbn/9781464260919-L.jpg"},"readingRecord":{"id":"goodreads-231819058-read-1","bookId":"goodreads-231819058","status":"completed","readingMethod":"physical","finishedAt":"2025-11-15","rating":3,"certifiedSlay":false,"readingNumber":1,"isReread":false,"progressEntries":[],"createdAt":"2026-10-06T16:56:09.944Z","updatedAt":"2026-10-06T16:56:09.944Z"},"rawShelves":[],"readCount":1,"wasTbbBuddyRead":false,"review":null},{"book":{"id":"goodreads-241735307","title":"The M.U.T.T. Hotel: A Short","authors":["Kyeate"],"pageCount":48,"publicationDate":"2025","status":"tbr","genreIds":[],"tropeIds":[],"tagIds":[],"shelfIds":[],"formats":["ebook"],"ownership":[],"primaryFormat":"ebook","certifiedSlay":false,"brainChemistry":false,"favorite":false,"goodreadsBookId":"241735307","dateAdded":"2025-11-15","source":"goodreads","c